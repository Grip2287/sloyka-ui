{
  "name": "sloyka",
  "version": "2.0.0",
  "description": "Sloyka — React-компоненты для операторских панелей и админок: светлая и тёмная тема, адаптив, проверка сборки.",
  "license": "MIT",
  "homepage": "https://github.com/Grip2287/sloyka-ui/blob/main/docs/GUIDE.md",
  "bugs": {
    "url": "https://github.com/Grip2287/sloyka-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "admin",
    "dashboard",
    "design-system",
    "sloyka"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grip2287/sloyka-ui.git"
  },
  "files": [
    "bin",
    "dist",
    "native",
    "components.json",
    "templates",
    "agents",
    "docs/GUIDE.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./templates/*": "./templates/*",
    "./native/*": "./native/*",
    "./check": {
      "types": "./dist/check/index.d.ts",
      "import": "./dist/check/index.js"
    },
    "./eslint": {
      "import": "./dist/check/eslint.js"
    },
    "./stylelint": {
      "import": "./dist/check/stylelint.js"
    },
    "./components.json": "./components.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-css.js && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/gen-manifest.ts && node scripts/build-check.js && node scripts/gen-components-md.js agents/components.md && node scripts/gen-native.js",
    "test": "vitest run",
    "new:component": "node scripts/new-component.js",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm test && npm run build-storybook && playwright test",
    "gen:docs": "node scripts/gen-components-md.js",
    "version:release": "changeset version && node scripts/release-notes.js --changelog --prev /tmp/prev/package/components.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@babel/eslint-parser": "^8.1.2",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "^10.6.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.4",
    "http-server": "^14.1.1",
    "lightningcss": "^1.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup-preserve-directives": "^1.1.3",
    "storybook": "^10.6.9",
    "stylelint": "^16.26.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "eslint": ">=9",
    "react": ">=18.3",
    "react-dom": ">=18.3",
    "stylelint": ">=16"
  },
  "dependencies": {
    "@babel/parser": "^8.1.3"
  },
  "bin": {
    "sloyka-check": "bin/sloyka-check.js"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
