{
  "name": "sloyka",
  "version": "0.1.0",
  "description": "Sloyka — библиотека React-компонентов для операторских панелей, лендингов и магазинов: светлая и тёмная тема, адаптив.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grip2287/sloyka-ui.git"
  },
  "files": [
    "dist",
    "components.json",
    "templates"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./templates/*": "./templates/*",
    "./components.json": "./components.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-css.js && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/gen-manifest.ts",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm test && npm run build-storybook && playwright test",
    "gen:docs": "node scripts/gen-components-md.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.1",
    "@storybook/html-vite": "^10.6.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "http-server": "^14.1.1",
    "lightningcss": "^1.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup-preserve-directives": "^1.1.3",
    "storybook": "^10.6.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3"
  }
}
