{
  "name": "@grip2287/sloyka",
  "version": "0.0.0",
  "description": "Sloyka — библиотека компонентов операторской панели: светлая и тёмная тема, адаптив.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grip2287/sloyka-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/sloyka.js",
  "exports": {
    ".": "./dist/sloyka.js",
    "./css": "./dist/sloyka.css",
    "./min.css": "./dist/sloyka.min.css",
    "./components/*.css": "./dist/components/*.css",
    "./theme-init": "./dist/theme-init.js",
    "./icons": "./dist/icons.js",
    "./fonts/*": "./dist/fonts/*"
  },
  "sideEffects": [
    "*.css",
    "./dist/sloyka.js"
  ],
  "scripts": {
    "build": "node scripts/build-css.js && vite build",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
