{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/react", "src/**/*.stories.tsx", ".storybook/*.tsx", ".storybook/*.ts", "tests/fixtures/*.tsx", "tests/unit/react/elements.test.tsx", "tests/unit/react/data.test.tsx"]
}
